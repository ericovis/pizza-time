option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: pizza_project.settings
    DEBUG: "false"
    SECRET_KEY: placeholder
    ALLOWED_HOSTS: placeholder
    DATABASE_NAME: placeholder
    DATABASE_USER: placeholder
    DATABASE_HOST: placeholder
    DATABASE_PORT: "5432"
    DATABASE_PASSWORD: placeholder
  # Amazon Linux 2023 Python platforms proxy through nginx; this replaces the
  # old aws:elasticbeanstalk:container:python:staticfiles namespace.
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
  aws:elasticbeanstalk:container:python:
    WSGIPath: pizza_project.wsgi:application

container_commands:
  01collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --no-input"
  02migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  03load_initial_data:
    command: "source /var/app/venv/*/bin/activate && python manage.py loaddata initial_data"
    leader_only: true
