# Copy to .env and adjust. Docker Compose reads .env automatically.

# --- Django ---
DEBUG=true
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Comma-separated. Defaults to * when unset.
ALLOWED_HOSTS=*
# Comma-separated. When empty, all origins are allowed (demo default) and no
# credentials are offered with them. List origins here to allow cookies too.
# A same-origin deployment (the API image serves the SPA) never needs CORS at
# all; listing the site's own origin there simply turns allow-all off.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Set to true only where a reverse proxy you control terminates TLS and sets
# X-Forwarded-Proto (Caramelo's edge does). Django then knows the request was
# secure: secure cookies, https in the URLs the API hands out, and an admin
# login that passes its CSRF origin check. Believing the header without such a
# proxy would let any client claim a secure connection.
TRUST_PROXY=false

# --- Database (Postgres) ---
DATABASE_NAME=pizza
DATABASE_USER=pizza
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Demo data (seed_demo runs after migrate on every boot) ---
# Delivery fee the server adds to every non-empty order. Authoritative: the
# frontend's own constant is only used for the cart preview.
DELIVERY_FEE=5.00
# The demo customer, printed on the frontend's sign-in screen.
DEMO_USERNAME=pizza
DEMO_PASSWORD=pizza
# The staff superuser for /admin/. Staff are refused a token at /api/auth/,
# so this account cannot sign in on the frontend.
ADMIN_USERNAME=pizza-admin
ADMIN_PASSWORD=pizza-admin
# seed_demo only sets a password when it creates the user, so changing these
# after the first boot needs `docker compose down -v` (or the admin).

# --- Static files and the bundled frontend ---
# Both are set in the image (STATIC_ROOT=/srv/static,
# FRONTEND_DIST=/srv/pizza-frontend) and live outside /code, which is
# bind-mounted in development. FRONTEND_DIST is the Vite build WhiteNoise
# serves at the web root; unset it and Django serves only /api/, /admin/ and
# /static/.
#STATIC_ROOT=
#FRONTEND_DIST=

# --- Frontend ---
# API base URL as seen from the browser (not from inside the container). The
# frontend container regenerates /config.js from it at start-up, which is
# where window.PIZZA_API_URL comes from. Leave it empty and the app calls
# port 8000 on whatever host the page was loaded from, so http://localhost:8080
# talks to localhost:8000 and http://<your-lan-ip>:8080 (a phone on the same
# network) talks to <your-lan-ip>:8000. Set it only when the API is elsewhere.
API_URL=
