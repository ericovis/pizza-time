# Copy to .env and adjust. Docker Compose reads .env automatically.

# --- Django ---
DEBUG=true
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Comma-separated. Defaults to * when unset.
ALLOWED_HOSTS=*
# Comma-separated. When empty, all origins are allowed (course demo default).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database (Postgres) ---
DATABASE_NAME=pizza
DATABASE_USER=pizza
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Frontend ---
# API base URL as seen from the browser, baked into static/js/config.js at
# container start-up.
API_URL=http://localhost:8000
